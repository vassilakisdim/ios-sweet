diff --git a/pexpert/pexpert/arm64/BONITO.h b/pexpert/pexpert/arm64/BONITO.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/BONITO.h
@@ -0,0 +1,21 @@
+/*
+ * Board config for Google Pixel 3a XL (bonito), Qualcomm SDM670.
+ *
+ * The early Bonito target shares XNU bring-up code developed for SWEET:
+ * plain arm64, 16K pages, GICv3 Group 1 IRQ handling, and no Apple monitor.
+ * Keep the actual MACHINE_CONFIG and DT match IDs BONITO-specific. Hardware
+ * support such as SDHCI/eMMC, panel power, Synaptics touch, and SMP is separate.
+ */
+#ifndef _PEXPERT_ARM64_BONITO_H
+#define _PEXPERT_ARM64_BONITO_H
+
+#include <pexpert/arm64/SWEET.h>
+
+#define BONITO                    1
+/* Existing shared XNU port patches use this feature switch. */
+#define ARM64_BOARD_CONFIG_SWEET  1
+
+/* SDM670's arm,armv8-timer virtual PPI is PPI 3 => GIC INTID 19. */
+#define BONITO_VTIMER_INTID       19
+
+#endif /* _PEXPERT_ARM64_BONITO_H */
